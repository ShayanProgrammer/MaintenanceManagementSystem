@MaintenanceManagementSystem.Api_HostAddress = http://localhost:5295

### Health (anonymous)
GET {{MaintenanceManagementSystem.Api_HostAddress}}/health
Accept: application/json

### Login as requester (Northgate Facilities, org 1)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "alice.requester@northgate.example",
  "password": "Pass123$"
}

### Login as approver (Northgate Facilities, org 1)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "bob.approver@northgate.example",
  "password": "Pass123$"
}

### Login as requester (Summit Property Group, org 2)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "carol.requester@summit.example",
  "password": "Pass123$"
}

### Login as approver (Summit Property Group, org 2)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "dave.approver@summit.example",
  "password": "Pass123$"
}

### Current identity (paste an accessToken from a login above in place of <token>)
GET {{MaintenanceManagementSystem.Api_HostAddress}}/api/auth/me
Authorization: Bearer <token>
Accept: application/json

### Current organization (any authenticated user; always the caller's own org)
GET {{MaintenanceManagementSystem.Api_HostAddress}}/api/organizations/current
Authorization: Bearer <token>
Accept: application/json

### Update approval threshold (approver only; caller's own org)
PUT {{MaintenanceManagementSystem.Api_HostAddress}}/api/organizations/current/threshold
Authorization: Bearer <approver-token>
Content-Type: application/json

{
  "approvalThreshold": 1500.00
}

### List sites (any authenticated user; caller's org only)
GET {{MaintenanceManagementSystem.Api_HostAddress}}/api/sites
Authorization: Bearer <token>
Accept: application/json

### Create site (approver only; org is assigned server-side from the token)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/sites
Authorization: Bearer <approver-token>
Content-Type: application/json

{
  "name": "New Warehouse",
  "description": "North warehouse"
}

### Update site (approver only; another org's id returns 404)
PUT {{MaintenanceManagementSystem.Api_HostAddress}}/api/sites/1
Authorization: Bearer <approver-token>
Content-Type: application/json

{
  "name": "HQ Tower (renamed)",
  "description": "Updated description"
}

### List maintenance requests (any authenticated user; caller's org only)
GET {{MaintenanceManagementSystem.Api_HostAddress}}/api/maintenance-requests
Authorization: Bearer <token>
Accept: application/json

### Create maintenance request, cost at/below threshold (any user;
### auto-approved by the system: status Approved, approvedByUserId null,
### audited as RequestRaised + AutoApproved with a null actor)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/maintenance-requests
Authorization: Bearer <token>
Content-Type: application/json

{
  "siteId": 1,
  "title": "Hallway light replacement",
  "description": "Two fittings out",
  "estimatedCost": 250.00
}

### Create maintenance request, cost above threshold (any user;
### status PendingApproval, audited as RequestRaised + SubmittedForApproval)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/maintenance-requests
Authorization: Bearer <token>
Content-Type: application/json

{
  "siteId": 1,
  "title": "HVAC compressor service",
  "description": "Noisy compressor",
  "estimatedCost": 1500.00
}

### Create maintenance request against another org's site (404, same as unknown id)
POST {{MaintenanceManagementSystem.Api_HostAddress}}/api/maintenance-requests
Authorization: Bearer <org1-token>
Content-Type: application/json

{
  "siteId": 3,
  "title": "Cross-tenant probe",
  "description": "Must fail",
  "estimatedCost": 50.00
}

###

